{
  "name": "duel-game-core",
  "version": "0.2.0",
  "description": "Rules-agnostic client plumbing for a TwoPlayer-engine-backed game: session identity, real-time push, and generic lobby/staging/rematch/debrief screens.",
  "type": "module",
  "main": "./dist/app.js",
  "types": "./dist/app.d.ts",
  "exports": {
    ".": { "types": "./dist/app.d.ts", "default": "./dist/app.js" },
    "./app.js": { "types": "./dist/app.d.ts", "default": "./dist/app.js" },
    "./render.js": { "types": "./dist/render.d.ts", "default": "./dist/render.js" },
    "./idl.js": { "types": "./dist/idl.d.ts", "default": "./dist/idl.js" },
    "./ic-env.js": { "types": "./dist/ic-env.d.ts", "default": "./dist/ic-env.js" },
    "./ws.js": { "types": "./dist/ws.d.ts", "default": "./dist/ws.js" },
    "./identity.js": { "types": "./dist/identity.d.ts", "default": "./dist/identity.js" },
    "./anon-identity.js": { "types": "./dist/anon-identity.d.ts", "default": "./dist/anon-identity.js" },
    "./types.js": { "types": "./dist/types.d.ts", "default": "./dist/types.js" },
    "./ws/gateway-client.js": { "types": "./dist/ws/gateway-client.d.ts", "default": "./dist/ws/gateway-client.js" },
    "./ws/gateway-transport.js": { "types": "./dist/ws/gateway-transport.d.ts", "default": "./dist/ws/gateway-transport.js" },
    "./ws/gateway-protocol.js": { "types": "./dist/ws/gateway-protocol.d.ts", "default": "./dist/ws/gateway-protocol.js" },
    "./style.css": "./style.css"
  },
  "files": [
    "dist",
    "style.css",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=21.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@icp-sdk/auth": "^8.0.3",
    "@icp-sdk/core": "^6.1.0",
    "cborg": "^4.2.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.9.0"
  }
}
