{
  "name": "duel-game-core",
  "version": "0.3.0",
  "description": "Rules-agnostic client for a duel-game-core game: session identity, polling transport, a headless client, and default lobby/staging/rematch/debrief screens any of which a game can replace.",
  "type": "module",
  "main": "./dist/app.js",
  "types": "./dist/app.d.ts",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./app.js": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./client.js": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./render.js": {
      "types": "./dist/render.d.ts",
      "default": "./dist/render.js"
    },
    "./idl.js": {
      "types": "./dist/idl.d.ts",
      "default": "./dist/idl.js"
    },
    "./ic-env.js": {
      "types": "./dist/ic-env.d.ts",
      "default": "./dist/ic-env.js"
    },
    "./transport.js": {
      "types": "./dist/transport.d.ts",
      "default": "./dist/transport.js"
    },
    "./identity.js": {
      "types": "./dist/identity.d.ts",
      "default": "./dist/identity.js"
    },
    "./anon-identity.js": {
      "types": "./dist/anon-identity.d.ts",
      "default": "./dist/anon-identity.js"
    },
    "./types.js": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./style.css": "./style.css"
  },
  "files": [
    "dist",
    "style.css",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=21.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@icp-sdk/auth": "^8.0.3",
    "@icp-sdk/core": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.9.0"
  }
}
