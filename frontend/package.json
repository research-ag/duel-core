    "./ic-env.js": "./ic-env.js",
    "./ws.js": "./ws.js",
    "./style.css": "./style.css"
  },
  "files": [
    "app.js",
    "render.js",
    "idl.js",
    "ic-env.js",
    "ws.js",
    "style.css",
    "README.md"
  ],
