{
  "name": "@research-ag/duel-game-core",
  "version": "0.4.1",
  "description": "Rules-agnostic client for a duel-game-core game: session identity, polling transport, a headless client, and default lobby/staging/rematch/debrief screens any of which a game can replace.",
  "keywords": [
    "internet-computer",
    "icp",
    "dfinity",
    "motoko",
    "canister",
    "game",
    "multiplayer",
    "two-player",
    "turn-based"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/research-ag/duel-core.git",
    "directory": "frontend"
  },
  "homepage": "https://github.com/research-ag/duel-core/tree/main/frontend#readme",
  "bugs": {
    "url": "https://github.com/research-ag/duel-core/issues"
  },
  "type": "module",
  "main": "./dist/app.js",
  "types": "./dist/app.d.ts",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./app.js": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./client.js": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./render.js": {
      "types": "./dist/render.d.ts",
      "default": "./dist/render.js"
    },
    "./idl.js": {
      "types": "./dist/idl.d.ts",
      "default": "./dist/idl.js"
    },
    "./ic-env.js": {
      "types": "./dist/ic-env.d.ts",
      "default": "./dist/ic-env.js"
    },
    "./transport.js": {
      "types": "./dist/transport.d.ts",
      "default": "./dist/transport.js"
    },
    "./identity.js": {
      "types": "./dist/identity.d.ts",
      "default": "./dist/identity.js"
    },
    "./anon-identity.js": {
      "types": "./dist/anon-identity.d.ts",
      "default": "./dist/anon-identity.js"
    },
    "./bots.js": {
      "types": "./dist/bots.d.ts",
      "default": "./dist/bots.js"
    },
    "./module-store.js": {
      "types": "./dist/module-store.d.ts",
      "default": "./dist/module-store.js"
    },
    "./types.js": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./style.css": "./style.css"
  },
  "files": [
    "dist",
    "src",
    "style.css",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=21.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@icp-sdk/auth": "^11.0.0",
    "@icp-sdk/core": "^6.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.9.0"
  }
}
