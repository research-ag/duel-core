{
  "name": "duel-game-core",
  "version": "0.1.0",
  "description": "Rules-agnostic client plumbing for a TwoPlayer-engine-backed game: session identity, real-time push, and generic lobby/staging/rematch/debrief screens.",
  "type": "module",
  "main": "app.js",
  "exports": {
    ".": "./app.js",
    "./app.js": "./app.js",
    "./render.js": "./render.js",
    "./idl.js": "./idl.js",
    "./ic-env.js": "./ic-env.js",
    "./ws.js": "./ws.js",
    "./ws/poller.js": "./ws/poller.js",
    "./ws/gateway-client.js": "./ws/gateway-client.js",
    "./ws/gateway-transport.js": "./ws/gateway-transport.js",
    "./ws/gateway-protocol.js": "./ws/gateway-protocol.js",
    "./style.css": "./style.css"
  },
  "files": [
    "app.js",
    "render.js",
    "idl.js",
    "ic-env.js",
    "ws.js",
    "ws",
    "style.css",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@dfinity/candid": "^2.4.1",
    "cborg": "^4.2.3"
  }
}
