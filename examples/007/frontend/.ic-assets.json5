[
  {
    "match": "**/*",
    "security_policy": "standard",
    "headers": {
      "Cache-Control": "public, max-age=0, must-revalidate",
      // Allow loading @dfinity/agent from esm.sh (vanilla-JS, no build step).
      // `upgrade-insecure-requests` is deliberately omitted: the local
      // replica is served over plain http://…localhost:8000.
      "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-eval' https://esm.sh https://*.esm.sh; style-src 'self' 'unsafe-inline'; connect-src 'self' https://esm.sh https://*.esm.sh https://ic0.app https://*.ic0.app https://icp0.io https://*.icp0.io http://localhost:* http://127.0.0.1:*; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none';"
    },
    "allow_raw_access": false
  },
  {
    "match": "**/*",
    "enable_aliasing": true
  }
]
