[
  {
    "match": "**/*",
    "security_policy": "standard",
    "headers": {
      "Cache-Control": "public, max-age=0, must-revalidate",
      // Allow loading @icp-sdk/core from esm.sh (vanilla-JS, no build step).
      // `upgrade-insecure-requests` is deliberately omitted: the local
      // replica is served over plain http://…localhost:8000.
      //
      // The 'sha256-...' entry allow-lists ONLY index.html's one inline
      // `<script type="importmap">` (see that file's comment for why it's
      // inline at all, and the command to recompute this hash if that
      // JSON ever changes) — deliberately NOT 'unsafe-inline', which
      // would allow any inline script, not just this one.
      "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-eval' 'sha256-vVba+358TlcberCD9mtzObK1gGCvssNrC+WF5sqSxDg=' https://esm.sh https://*.esm.sh; style-src 'self' 'unsafe-inline'; connect-src 'self' https://esm.sh https://*.esm.sh https://ic0.app https://*.ic0.app https://icp0.io https://*.icp0.io http://localhost:* http://127.0.0.1:*; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none';"
    },
    "allow_raw_access": false
  },
  {
    "match": "**/*",
    "enable_aliasing": true
  }
]
