# This is a static asset canister: whatever lands in node_modules/ is
# served byte-for-byte (see angular.json's `assets`, which copies
# node_modules/duel-game-core into the build output). A plain `file:`
# dependency installs as a symlink by default, which an asset-sync step
# may not follow — install-links forces npm to copy the real files
# instead.
install-links=true
