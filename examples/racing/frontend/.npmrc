# A plain `file:` dependency installs as a symlink by default, which
# esbuild's own module resolution may not follow correctly when bundling
# — install-links forces npm to copy the real duel-game-core files into
# node_modules/ instead, so build.js's two esbuild passes (main.ts into
# dist/main.js, duel/duel-app.js into dist/duel-app.js) can resolve it
# like any other real package before bundling everything into dist/ (see
# build.js — that bundle, not node_modules/, is what's actually deployed).
install-links=true
