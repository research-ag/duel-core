# A plain `file:` dependency installs as a symlink by default — npm
# treats it as a stripped-down link, not a regular install, and skips
# fetching ITS OWN declared dependencies (@icp-sdk/auth, @icp-sdk/core — see
# ../../../frontend/package.json). install-links instead packs
# @research-ag/duel-game-core like a normal registry dependency, so npm installs
# those transitive dependencies too — required before build.js's esbuild
# step can bundle the package's modules (which import them directly)
# into dist/.
install-links=true
