# Copy to .env and adjust as needed: `cp .env.example .env`

# Upstream release tag to build — see
# https://github.com/omnia-network/ic-websocket-gateway/releases
GATEWAY_VERSION=v1.4.6

# Port the gateway listens on, exposed to the host.
GATEWAY_PORT=8080

# The IC replica the gateway polls. From inside the container,
# `host.docker.internal` reaches a replica bound to localhost on the host
# (e.g. `dfx start` / `icp network start`, default port 4943). Point this
# at https://icp-api.io instead to run against mainnet.
IC_NETWORK_URL=http://host.docker.internal:4943

# How often (ms) the gateway polls each canister's ws_get_messages.
POLLING_INTERVAL=100
