<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>__GAME_TITLE__</title>
    <link rel="stylesheet" href="/duel-game-core.css" />
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <header>
      <h1>__GAME_TITLE__</h1>
      <div class="session">
        <!-- LEADERBOARD:
        <button id="leaderboard-toggle" title="Leaderboard" aria-label="Leaderboard">🏆</button>
        -->
        <span class="label">Session</span>
        <code id="sid">…</code>
        <button id="new-sid" title="Play as a different session">new</button>
      </div>
    </header>

    <!-- LEADERBOARD:
    <div id="leaderboard-panel" hidden>
      <div class="leaderboard-header">
        <button id="leaderboard-back" class="ghost">← Back</button>
        <h2>🏆 Top players</h2>
      </div>
      <div id="leaderboard-body" class="leaderboard-list"></div>
    </div>
    -->

    <!-- BOTS:
    <div id="bot-challenge-panel" hidden>
      <div class="bot-challenge-header">
        <button id="bot-challenge-back" class="ghost">← Back</button>
        <h2>🤖 Bots</h2>
      </div>
      <div id="bot-challenge-body" class="bot-challenge-body"></div>
    </div>
    -->

    <p id="error" class="error" hidden></p>

    <main id="screen">
      <p class="muted">Connecting…</p>
    </main>

    <!-- BOTS:
    <div id="bot-add-panel" hidden>
      <button id="bot-add-trigger" class="ghost">Add Bot 🤖 to the open seat</button>
    </div>
    -->

    <footer>
      <p class="muted">
        Your session id is per browser tab — open a second tab to play the
        other seat. An idle game can be taken over after
        __IDLE_TIMEOUT_SECONDS__&nbsp;seconds.
      </p>
    </footer>

    <!-- esbuild's bundle of src/app.js (see ../build.js). -->
    <script type="module" src="/app.js"></script>
  </body>
</html>
