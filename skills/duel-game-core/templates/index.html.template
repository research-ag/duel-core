<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>__GAME_TITLE__</title>
    <link rel="stylesheet" href="/duel-game-core.css" />
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <header>
      <h1>__GAME_TITLE__</h1>
      <div class="session">
        <span class="label">Session</span>
        <code id="sid">…</code>
        <button id="new-sid" title="Play as a different session">new</button>
      </div>
    </header>

    <p id="error" class="error" hidden></p>

    <main id="screen">
      <p class="muted">Connecting…</p>
    </main>

    <footer>
      <p class="muted">
        Your session id is per browser tab — open a second tab to play the
        other seat. An idle table can be taken over after
        __IDLE_TIMEOUT_SECONDS__&nbsp;seconds.
      </p>
    </footer>

    <!-- esbuild's bundle of src/app.js (see ../build.js). -->
    <script type="module" src="/app.js"></script>
  </body>
</html>
