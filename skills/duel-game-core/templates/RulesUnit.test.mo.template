// Unit checks for __RULES_MODULE__: init/validate/resolve (or move) called
// directly, no engine. One block per illegal move and per win/lose/draw
// path. `assert` + `Runtime.trap`.
//
// Run: moc -r --package core <path-to-core/src> --package duel-game-core
//      <path-to-duel-game-core-backend/src> --package prng <path-to-prng/src>
//      test/RulesUnit.test.mo
import R "../src/__RULES_MODULE__";
import TP "mo:duel-game-core";
import Rng "mo:duel-game-core/rng";
import Debug "mo:core/Debug";
import Runtime "mo:core/Runtime";

// A fixed seed makes every run identical.
let rng = Rng.new(42);
let options : R.Options = {};

// #simultaneous: one round, trapping if it ended unexpectedly.
func round(s : R.State, a1 : R.Action, a2 : R.Action) : R.State {
  let r = R.resolve(s, a1, a2, rng);
  switch (r.verdict) { case null {}; case (?_) Runtime.trap("unexpected end") };
  r.state;
};

// #turnBased equivalent (see references/turn-based-games.md): one action,
// trapping on a rejection or an unexpected end.
// func step(s : R.State, seat : TP.Seat, a : R.Action) : R.State {
//   switch (R.move(s, seat, a, rng)) {
//     case (#err why) Runtime.trap("rejected: " # why);
//     case (#ok { state; verdict = ?_ }) Runtime.trap("unexpected end");
//     case (#ok { state; verdict = null }) state;
//   };
// };

// 1. checkOptions accepts the default options, init is a clean slate and
// `spec` hands out these functions. With options, also test init per
// option value plus one `checkOptions` rejection.
assert R.checkOptions(options) == null;
let s0 = R.init(options, rng);
let sp = switch (R.spec) {
  case (#simultaneous s) s;
  case (#turnBased _) Runtime.trap("expected a #simultaneous spec");
};
let s1 = sp.init(options, rng);
// assert <fields of s1 match your fresh-state expectations>;
Debug.print("1. options + init + spec wiring OK");

