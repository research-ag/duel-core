// Unit checks for __RULES_MODULE__: init/validate/resolve called directly,
// no engine. One block per illegal move in `validate` and per
// win/lose/draw path in `resolve`. `assert` + `Runtime.trap`.
//
// Run: moc -r --package core <path-to-core/src> --package duel-game-core
//      <path-to-duel-game-core-backend/src> test/RulesUnit.test.mo
import R "../src/__RULES_MODULE__";
import TP "mo:duel-game-core";
import Debug "mo:core/Debug";
import Runtime "mo:core/Runtime";

// #simultaneous: one round, trapping if it ended unexpectedly.
func round(s : R.State, a1 : R.Action, a2 : R.Action) : R.State {
  let r = R.resolve(s, a1, a2);
  switch (r.verdict) { case null {}; case (?_) Runtime.trap("unexpected end") };
  r.state;
};

// #alternating equivalent (see references/alternating-turn-games.md).
func turnRound(s : R.State, seat : TP.Seat, a : R.Action) : R.State {
  let r = R.resolve(s, seat, a);
  switch (r.verdict) { case null {}; case (?_) Runtime.trap("unexpected end") };
  r.state;
};

// 1. init("") is a clean slate and spec() hands out these functions. With
// variants, also test init per variant key plus one unrecognized string.
let s0 = R.init("");
let sp = switch (R.spec()) {
  case (#simultaneous s) s;
  case (#alternating _) Runtime.trap("expected a #simultaneous spec");
};
let s1 = sp.init("");
