// Host actor for __GAME_SLUG__. Copy verbatim; only the `Rules` import
// and the two timeouts change between games. `status`, `http_request` and
// the HTTP mixin's controllers-only `wasm_upload_*` are the only plain
// Candid methods — every game mutation goes through
// `mo:duel-game-core/transport`.

import Time "mo:core/Time";

import TP "mo:duel-game-core";
import Registry "mo:duel-game-core/registry";
import Transport "mo:duel-game-core/transport";
import ActorMixin "mo:duel-game-core/actor_mixin";
import HttpActorMixin "mo:duel-game-core/http_actor_mixin";
import PT "mo:promtracker";
import Tracker "mo:promtracker/Tracker"; // brings `pt.toValue()` into scope

import Rules "__RULES_MODULE__";

persistent actor {
  // Metrics: the registry's four game metrics plus promtracker's system
  // ones, served at GET /metrics (Prometheus exposition).
  let pt = PT.Tracker.new(); // plain data — stable
  transient let renderer = PT.Renderer(); // closures — rebuilt on upgrade
  renderer.addValue(PT.allSystemMetrics);
  renderer.addValue(pt.toValue());

  let registry : TP.Registry<Rules.State, Rules.Action> = Registry.new();
  registry.setTimeouts(__IDLE_TIMEOUT_NS__, __CLAIM_TIMEOUT_NS__); // re-applied on every upgrade
  registry.attachMetrics(pt); // games_started / active_games / rounds_per_game / matchmaking_wait_seconds

  public query func status(sid : Text) : async TP.SessionStatus<Rules.State> {
    registry.status(Rules.spec(), Time.now(), sid);
  };

  transient let hub : Transport.Hub = Transport.createHub();
  transient let attached = Transport.attach<Rules.State, Rules.Action>(
    Rules.spec(),
    registry,
    hub,
    {
      encode = func(m : Transport.Msg<Rules.State, Rules.Action>) : Blob = to_candid (m);
      decode = func(b : Blob) : ?Transport.Msg<Rules.State, Rules.Action> = from_candid (b);
    },
    null, // onSettled — canister players
    null, // onGameEnded — leaderboard
    null, // onGameStarted — leaderboard
  );

  include ActorMixin<system>(attached.endpoint, attached.sweep);

  // GET /semantics — the rules text a third-party frontend is built from;
  // GET /metrics — the metrics above. GET /wasm is the mixin's own.
  include HttpActorMixin([
    ("/semantics", func() : Text = Rules.SEMANTICS),
    ("/metrics", renderer.renderExposition),
  ]);
};
