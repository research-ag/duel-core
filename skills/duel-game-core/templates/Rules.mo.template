  public func sideName(seat : TP.Seat) : Text = switch (seat) {
    case (#p1) "__P1_NAME__";
    case (#p2) "__P2_NAME__";
  };

  func freshSide() : Side = {
    // starting values
  };

  /// `raw` is this table's rules variant text ("" without variants).
  /// Rename to `_raw` if unused.
  public func init(raw : Text) : State = {
    p1 = freshSide();
    p2 = freshSide();
    lastRound = null;
    // variant = parseVariant(raw);
  };

  /// null = legal. The only legality gate in the system; the frontend's
  /// disabled buttons are cosmetic.
  public func validate(s : State, seat : TP.Seat, a : Action) : ?Text {
    let me = switch (seat) { case (#p1) s.p1; case (#p2) s.p2 };
    switch (a) {
      // case (#yourMove) if (illegal) ?"reason" else null;
      // case (#yourMove) if (s.variant == #classic) ?"yourMove is not available in classic mode" else null;
      case (_) null;
    };
  };

  /// Both moves are in and already validated. Guard every Nat
  /// subtraction against underflow.
  public func resolve(s : State, a1 : Action, a2 : Action)
    : { state : State; verdict : ?TP.Verdict } {

    // let verdict : ?TP.Verdict =
