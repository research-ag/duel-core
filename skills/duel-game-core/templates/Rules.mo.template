/// __RULES_MODULE__ — __GAME_TITLE__ game logic, as a pure module.
///
/// `#simultaneous`: both seats act every round. For an alternating-turn
/// game build `#alternating { init; validate; resolve }` instead, where
/// `resolve : (State, TP.Seat, Action) -> ...` takes the one seat on turn
/// (see references/alternating-turn-games.md).
///
/// Seats: #p1 = __P1_NAME__, #p2 = __P2_NAME__ (display only).
///
/// Rules:
///   __ONE LINE PER MOVE/RULE, PLAIN ENGLISH — replace this block with the
///   actual rules text.__

import TP "mo:duel-game-core";

module {

  /// Served at `GET /semantics`: everything a frontend author who cannot
  /// see this file needs. Keep the section names; replace their bodies
  /// (SKILL.md step 3). No `"` or `\` inside without escaping.
  public let SEMANTICS : Text = "GAME: __GAME_TITLE__
MODE: simultaneous
SEATS: p1 = __P1_NAME__, p2 = __P2_NAME__
VARIANTS: none (the table variant text is ignored)

STATE (Candid)
  type State = record { ... };
  What every field means: indexing, units, what null stands for.

ACTION (Candid)
  type Action = variant { ... };

RULES
  What each action does, and every condition that gets it rejected.

ENDINGS
  Every way the game is won, lost or drawn.

CLIENT NOTES
  What a UI must know that the state does not say outright.
";

